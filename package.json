{
  "name": "characterbot",
  "productName": "PixelBot",
  "version": "0.2.0",
  "description": "Desktop AI bot team on your own Claude and ChatGPT subscriptions",
  "author": "SUNGMYEONGGI",
  "private": true,
  "main": "out/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p .",
    "test": "tsx test/main.test.ts",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64",
    "site": "node scripts/build-site.mjs"
  },
  "build": {
    "appId": "com.sungmyeonggi.characterbot",
    "productName": "PixelBot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "out/stt.swift",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/@openai/codex-*/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "음성 메모와 음성 채팅에 마이크를 사용합니다.",
        "NSSpeechRecognitionUsageDescription": "음성을 기기 안에서 텍스트로 바꿉니다."
      }
    },
    "dmg": {
      "title": "PixelBot",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "SUNGMYEONGGI",
      "repo": "CharacterBot"
    },
    "afterPack": "build/adhoc-sign.cjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "dompurify": "3.4.16",
    "electron": "38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "katex": "0.16.47",
    "marked": "18.1.0",
    "mermaid": "11.17.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@38.2.0": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "^0.163.0",
    "zod": "^4.6.7"
  },
  "license": "Apache-2.0"
}
